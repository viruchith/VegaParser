---
filepath: {{ filepath }}
language: {{ language }}
imports:
{% for imp in imports %}  - {{ imp | tojson }}
{% endfor %}exports:
{% for exp in exports %}  - {{ exp | tojson }}
{% endfor %}{% if internal_dependencies %}internal_dependencies:
{% for dep in internal_dependencies %}  - {{ dep | tojson }}
{% endfor %}{% endif %}{% if external_calls %}external_calls:
{% for call in external_calls %}  - pattern: {{ call.pattern | tojson }}
    line: {{ call.line }}
{% endfor %}{% endif %}{% if external_urls %}external_urls:
{% for u in external_urls %}  - url: {{ u.url | tojson }}
    line: {{ u.line }}
{% endfor %}{% endif %}{% if database_endpoints %}database_endpoints:
{% for db in database_endpoints %}  - type: {{ db.connection_type | tojson }}
    host: {{ db.host | tojson }}
    port: {{ db.port | tojson }}
    user: {{ db.user | tojson }}
    schema: {{ db.schema | tojson }}
    database: {{ db.database | tojson }}
    line: {{ db.line }}
{% endfor %}{% endif %}---

